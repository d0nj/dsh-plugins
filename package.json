{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin collection: Cordis bundles installed into a dsh profile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0nj/dsh-plugins.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:websearch-multi": "turbo run build --filter=@d0nj/dsh-websearch-multi"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  }
}
