{
  "name": "@d0nj/dsh-browser",
  "version": "0.1.1",
  "description": "A real browser for DeepSeek Harness agents, headless by default: the `browser` tool navigates, reads the page as a numbered accessibility tree, and clicks, types and scrolls by ref.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0nj/dsh-plugins.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "browser-use",
    "browser-automation",
    "chrome",
    "cdp",
    "accessibility-tree"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/**/*.test.js\"",
    "check": "node --check dist/index.js && node --check dist/tool.js && node --check dist/host.js && node --check dist/tab.js && node --check dist/cdp.js && node --check dist/ws.js && node --check dist/launch.js && node --check dist/idle.js",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','dist-test'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
