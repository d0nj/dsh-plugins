{
  "name": "@d0nj/dsh-codemode",
  "version": "0.1.1",
  "description": "Programmatic tool calling for DeepSeek Harness agents: one `run_code` program composes tool calls, discovers signatures on demand through a searchable catalog, and keeps chosen tools directly callable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0nj/dsh-plugins.git",
    "directory": "packages/codemode"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "codemode",
    "programmatic-tool-calling",
    "tool-executor",
    "ptc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/**/*.test.js\"",
    "check": "node --check dist/index.js && node --check dist/config.js && node --check dist/catalog.js && node --check dist/prompt.js && node --check dist/limits.js && node --check dist/ptc.js && node --check dist/transport.js && node --check dist/program.js && node --check dist/dispatch.js && node --check dist/executor.js",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','dist-test'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
