/**
 * Emit configuration for the shipped files.
 *
 * The tests are excluded here, so `dist/` contains only what the Harness loads.
 * Tests are compiled separately by `tsconfig.test.json` and run from `dist-test/`,
 * which keeps them out of the package's published surface while still checking
 * them with the same strictness.
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/fixtures.ts"]
}
